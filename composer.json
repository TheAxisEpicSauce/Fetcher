{
    "name": "taes/fetcher",
    "type": "library",
    "description": "Your package description goes here",
    "keywords": ["database"],
    "license": "MIT",
    "authors": [
        {
            "name": "Raphael Pelissier",
            "email": "peliraph@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-pdo": "*",
        "ext-ctype": "*",
        "mongodb/mongodb": "^2.3",
        "ext-redis": "*"
    },
    "autoload": {
        "psr-4": {
            "Fetcher\\": "src/"
        },
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^5.4"
    },
    "scripts": {
        "test": [
            "php vendor/bin/phpunit tests"
        ]
    },
    "bin": ["bin/cache-fetchers"]
}
